{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "BotSpace theme",
  "description": "Colour tokens (Material 3 values on shadcn role names), tonal status pairs, chart colours, layout sizes and the shape rules: pill buttons, 6 px chips, 8 px inputs and menus, Inter.",
