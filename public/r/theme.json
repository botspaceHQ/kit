      "chart-5": "#8b9297"
    }
  },
  "css": {
    ":root": {
      "--header-height": "56px",
      "--rail-width": "56px",
      "--subnav-width": "240px",
      "--pane-width": "320px"
    },
    "[data-slot=\"button\"]": {
      "border-radius": "9999px"
    },
    "[data-slot=\"badge\"]": {
      "border-radius": "6px"
    },
    "[data-slot=\"tabs-list\"], [data-slot=\"tabs-trigger\"]": {
      "border-radius": "9999px"
    },
    "[data-slot=\"avatar\"], [data-slot=\"avatar-fallback\"]": {
      "border-radius": "9999px"
    },
    "button:not(:disabled), [role=\"button\"]:not([aria-disabled=\"true\"]), a[href], label[for], summary": {
      "cursor": "pointer"
    },
    "button:disabled, [aria-disabled=\"true\"]": {
      "cursor": "not-allowed"
    },
    "@layer base": {
      "body": {
        "font-feature-settings": "'cv11', 'ss01'"
      }
    }
  },
  "meta": {
    "version": "0.1.0"
  },
  "type": "registry:theme"
}